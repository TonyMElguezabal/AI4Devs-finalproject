# JOS-194 proof of concept — F4: Caddy serves the built frontend and forwards /api to the backend.
# Build context: the repository root.
ARG NODE_VERSION=26.4.0
FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /w
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./
# Relative API base: the same build serves every environment (design Decision 3, F4).
ENV VITE_API_BASE=/api
RUN npm run build

FROM caddy:2.10-alpine
COPY --from=build /w/dist /srv
COPY openspec/changes/define-production-deployment/poc/Caddyfile /etc/caddy/Caddyfile
