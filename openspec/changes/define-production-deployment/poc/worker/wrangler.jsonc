{
  // JOS-194 proof of concept. Secrets are set with `wrangler secret put`, never in this file.
  "name": "vid4you-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The page must only ever be reachable through the Access-protected custom domain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "poc.vid4you.download", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "containers": [
    {
      "class_name": "Vid4YouBackend",
      "image": "../Dockerfile",
      "image_build_context": "../../../../..",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "BACKEND", "class_name": "Vid4YouBackend" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vid4YouBackend"] }],
  "vars": { "POC_MODE": "stub", "ALLOW_TEST_ENDPOINTS": "1" },
  "observability": { "enabled": true }
}
