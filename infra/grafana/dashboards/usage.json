{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Grafana Cloud metrics)",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    }
  ],
  "uid": "vid4you-usage",
  "title": "Vid4You — usage funnel",
  "description": "Application starts, sessions started and final videos from opted-in installs.",
  "tags": [
    "vid4you"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "multi": true,
        "includeAll": false,
        "query": "production,uat,development",
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "uat",
            "value": "uat",
            "selected": true
          },
          {
            "text": "development",
            "value": "development",
            "selected": false
          }
        ],
        "current": {
          "text": [
            "production",
            "uat"
          ],
          "value": [
            "production",
            "uat"
          ]
        },
        "description": "development builds are hidden by default"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Counts come only from installs that opted in to anonymous usage counts, so they under-count real usage."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "title": "Funnel",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "App starts",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(vid4you_app_starts_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Sessions started",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(vid4you_sessions_started_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Final videos",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(vid4you_final_videos_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Sessions reaching a final video",
      "description": "Final videos divided by sessions started in the same range; sessions that finish after the range ends are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(vid4you_final_videos_total{deployment_environment=~\"$env\"}[$__range])) / sum(increase(vid4you_sessions_started_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "id": 6,
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Over time",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Daily activity",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(vid4you_app_starts_total{deployment_environment=~\"$env\"}[1d]))",
          "legendFormat": "App starts",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(vid4you_sessions_started_total{deployment_environment=~\"$env\"}[1d]))",
          "legendFormat": "Sessions started",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(vid4you_final_videos_total{deployment_environment=~\"$env\"}[1d]))",
          "legendFormat": "Final videos",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "bargauge",
      "title": "Final videos per version",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (service_version) (increase(vid4you_final_videos_total{deployment_environment=~\"$env\"}[$__range]) * on (job, instance) group_left (service_version) target_info{job=\"vid4you\", deployment_environment=~\"$env\"})",
          "legendFormat": "{{service_version}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      }
    }
  ]
}
